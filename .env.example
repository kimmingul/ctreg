# ctreg 환경변수 견본. 이 파일을 `.env` 로 복사해서 값을 채우세요.
# `.env` 는 .gitignore 에 있어 커밋되지 않습니다.
#
# ── CRIS(국내 임상연구정보서비스) serviceKey ──────────────────────────────
#
# 받는 법 (자동승인, 몇 분):
#   1. https://www.data.go.kr 회원가입·로그인
#   2. '질병관리청_임상연구 DB' 검색 → https://www.data.go.kr/data/3033869/openapi.do
#   3. [활용신청] → 개발계정(자동승인). 활용목적은 연구/개인 용도로 적으면 된다.
#   4. 마이페이지 → 오픈API → 인증키에서 **일반 인증키(Decoding)** 을 복사
#
# 둘 중 왜 Decoding 인가. 포털은 Encoding·Decoding 두 벌을 준다. ctreg 는 요청을
# `url.searchParams.set` 으로 만들고 그것이 값을 **스스로 인코딩** 한다 — 이미 인코딩된
# Encoding 키를 넣으면 `%2B` 가 `%252B` 로 두 번 인코딩되어 인증이 실패한다.
# (구분법: Decoding 값에는 `+` 나 `=` 가 그대로 보이고, Encoding 값에는 `%2B`·`%3D` 가 보인다.)
#
CTREG_CRIS_SERVICE_KEY=

# CRIS 의 두 번째 문 — 사본. KCTIS(https://github.com/kimmingul/KCTIS)가 공식 API 로 받아 둔
# CRIS 전체(12,585건, 상세 포함)를 `/api/cris/*` 로 낸다. 이 값이 있으면 CRIS 어댑터가 위 키 대신
# 이것을 본다: 연구책임자 이름이 목록 축이 되어 `ctreg names 김민걸` 이 --term 없이, 수 초에 답한다.
# 사본이라 응답마다 수집 시각이 경고(cris_mirror_copy)로 붙는다. 비워 두면 공식 API 문을 쓴다.
CTREG_CRIS_MIRROR_URL=

# ── 선택 ────────────────────────────────────────────────────────────────
# 엔드포인트를 바꿔야 할 때만 쓴다. 비워 두면 기본값을 쓴다.
# CTREG_CRIS_BASE_URL=https://apis.data.go.kr/1352159/crisinfodataview

# ── WHO ICTRP 자동 조회 ──────────────────────────────────────────────────
#
# **기본은 꺼져 있습니다.** ICTRP 검색 화면은 robots.txt 가 자동 접근을 막고 있고
# (Disallow: /), WHO 가 자동 조회용으로 내놓은 Web Service 와 Crawling Service 는
# 둘 다 사무국과의 합의와 비용을 요구합니다("an agreed partner website").
#
#   문의: ictrpinfo@who.int
#   https://www.who.int/tools/clinical-trials-registry-platform/the-ictrp-search-portal
#
# 합의가 있어 쓰실 수 있다면 아무 값이나 넣어 켜세요. 나머지 세 레지스트리는
# 이 설정과 무관하게 그대로 동작합니다.
#
# CTREG_ICTRP_ACKNOWLEDGED=1

# ── AI 모드 (검색 웹페이지) ───────────────────────────────────────────────
#
# 검색창의 자연어를 도구·조건으로 바꾸는 LLM. OpenAI 호환 API 면 된다 — Ollama Cloud,
# OpenAI, 로컬 Ollama(http://localhost:11434/v1) 전부. **키가 없으면 AI 모드 칩이 "아직
# 켜져 있지 않다" 고 답하고 나머지 페이지는 그대로 동작한다.**
#
# LLM 이 하는 일은 조건 변환 하나다 — 결과를 요약하거나 해석하지 않는다. 그건 이 도구가
# 없애려는 "조용히 틀린 답" 이 페이지로 돌아오는 길이다.
#
# 공개 서버에 두면 URL 을 아는 누구나 이 키로 LLM 을 돌린다. 구독 한도가 곧 상한이다.
#
CTREG_LLM_API_KEY=
CTREG_LLM_BASE_URL=https://ollama.com/v1
CTREG_LLM_MODEL=glm-5.3-flash

# AI 모드(에이전트)의 상한 — 비워 두면 기본값. 턴 = 모델 호출 수(한 턴의 병렬 도구 호출은 한 턴치).
# CTREG_AGENT_MAX_TURNS=12
# CTREG_AGENT_MAX_PARALLEL=30
# CTREG_AGENT_MAX_MS=360000
# CTREG_AGENT_LLM_TIMEOUT_MS=150000
