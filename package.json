{
  "name": "@kimmingul/ctreg",
  "version": "0.2.0",
  "description": "Query clinical trial registries through one normalized schema.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Min-Gul Kim",
    "url": "https://github.com/kimmingul"
  },
  "homepage": "https://github.com/kimmingul/ctreg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimmingul/ctreg.git"
  },
  "bugs": {
    "url": "https://github.com/kimmingul/ctreg/issues"
  },
  "keywords": [
    "clinical-trials",
    "clinicaltrials-gov",
    "isrctn",
    "ictrp",
    "cris",
    "ctis",
    "registry",
    "cli",
    "claude-code",
    "claude-code-plugin",
    "research",
    "ctreg"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ctreg": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test",
    "compile": "bun build src/cli/bin.ts --compile --define __CTREG_VERSION__=\"\\\"$npm_package_version\\\"\" --outfile ctreg",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "field-test": "bun run scripts/field-test.ts",
    "isrctn-field-test": "bun run scripts/isrctn-field-test.ts",
    "ictrp-field-test": "bun run scripts/ictrp-field-test.ts",
    "cris-field-test": "bun run scripts/cris-field-test.ts",
    "ctis-field-test": "bun run scripts/ctis-field-test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
